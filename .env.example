# Mon Paris account used on tennispadel.paris.fr. Required for book.js, not for scan.js.
ACCOUNT_EMAIL=
ACCOUNT_PASSWORD=

# Optional push notifications via ntfy.sh. Leave blank to disable.
NTFY_TOPIC=
NTFY_DOMAIN=

# CAPTCHA strategy: manual (default, visible browser) | none (fail fast, for CI)
# "api" is a placeholder with no provider implementation. See lib/captcha.js.
CAPTCHA_PROVIDER=manual
