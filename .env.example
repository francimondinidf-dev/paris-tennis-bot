# tennis.paris.fr account. Required.
ACCOUNT_EMAIL=
ACCOUNT_PASSWORD=

# Optional push notifications via ntfy.sh. Leave blank to disable.
NTFY_TOPIC=
NTFY_DOMAIN=

# CAPTCHA strategy: manual (default, needs --headed) | none (fail fast, for CI)
# "api" is a placeholder with no provider implementation. See lib/captcha.js.
CAPTCHA_PROVIDER=manual

# Override the target date instead of the default D+6. Format YYYY-MM-DD.
TARGET_DATE=
