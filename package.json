{
  "name": "paris-tennis-bot",
  "version": "0.2.0",
  "type": "module",
  "description": "Weekend court finder/booker for tennispadel.paris.fr (Paris Tennis Padel). Dormant by default.",
  "scripts": {
    "venues": "node build-venues.js",
    "scan": "node scan.js",
    "scan:snipe": "node scan.js --mode=snipe",
    "horizon": "node scan.js --horizon",
    "book:dry": "node book.js --dry-run",
    "book": "node book.js",
    "build:venues": "node build-venues.js"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "ics": "^3.7.6",
    "playwright": "^1.48.0"
  }
}
